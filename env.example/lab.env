LAB_NODE_ENV=development
LAB_FORCE_COLOR=1

# OpenObserve Ingestion Config
LAB_TELEMETRY_ENABLED="true"
LAB_OPENOBSERVE_URL="http://openobserve:5080"
LAB_OPENOBSERVE_ORG="default"
LAB_OPENOBSERVE_LOG_STREAM="lab_logs"
LAB_OPENOBSERVE_TRACE_STREAM="lab_traces"
LAB_OPENOBSERVE_USER="admin@example.com"
LAB_OPENOBSERVE_PASSWORD="ChangeMe123!"

# Vector
LAB_VECTOR_INGEST_URL="http://vector:8686/events"
LAB_VECTOR_STREAM_URL="ws://vector:8687"

# Database
LAB_SURREALDB_HOST="http://surrealdb:6800/"

# Add these entries to env/lab.env
LAB_IGGY_URL=http://iggy:3000
LAB_IGGY_STREAM=lab
LAB_IGGY_USER=iggy
LAB_IGGY_PASSWORD=iggy
