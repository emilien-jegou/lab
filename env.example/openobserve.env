ZO_ROOT_USER_EMAIL=admin@example.com
ZO_ROOT_USER_PASSWORD=ChangeMe123!
ZO_DATA_DIR=/data

ZO_COMPACT_DATA_RETENTION_DAYS=7
ZO_IGNORE_FILE_RETENTION_BY_STREAM=true

# Kanidm OIDC Configuration
ZO_OIDC_ENABLED=true
ZO_OIDC_PROVIDER_NAME="Kanidm"
ZO_OIDC_ISSUER="http://idm.localhost:8000/oauth2/openid/openobserve"
ZO_OIDC_CLIENT_ID="openobserve"
ZO_OIDC_CLIENT_SECRET="SecretOpenObserveToken123!"
ZO_OIDC_SCOPES="openid,profile,email"
ZO_OIDC_USER_IDENTIFIER="email"
